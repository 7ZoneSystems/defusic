# HearBeat Frontend Configuration
# Copy to .env.local for local development
# For Vercel: set these in the Vercel dashboard under Settings > Environment Variables

# Backend API URL (local development only)
# In production, requests are proxied via /api/hearbeat → GCP backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Drive OAuth (create at https://console.cloud.google.com/apis/credentials)
# OAuth 2.0 Client ID (type: Web application)
# Authorized redirect URI: https://defusic.vercel.app/auth/drive-callback
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
