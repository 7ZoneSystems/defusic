# Hearbeat Configuration
# Copy to .env and adjust as needed

# FFmpeg binary path (if not in PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Analysis output directory
OUTPUT_DIR=./outputs

# Local models directory (run setup_models.py to download)
MODELS_DIR=./models

# Demucs model to use for source separation
# Options: htdemucs, htdemucs_ft, htdemucs_6s
DEMUCS_MODEL=htdemucs

# Device for PyTorch inference: cpu, cuda, mps
DEVICE=cpu

# Sample rate for analysis audio
ANALYSIS_SAMPLE_RATE=44100

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Max upload size in MB
MAX_UPLOAD_MB=100
